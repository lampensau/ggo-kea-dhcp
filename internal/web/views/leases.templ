package views

// Leases is one unified table of DHCP leases AND client (MAC) reservations: each
// device is a single row, tagged Reserved when its IP is fixed. Search is a
// debounced Datastar @get that re-merges #leases-body; the live channel pushes the
// same region as leases come and go. LeasesBody is the shared partial (first paint
// + fragment). "Reserve a Client IP" opens the ReserveDialog for a manual entry.
templ Leases(v LeasesView) {
	@Base(v.Page) {
		@PageHead("Leases", "Active DHCP leases and client reservations - search by IP, MAC, hostname, or class.") {
			if v.CanReserve {
				<button type="button" class="btn btn-secondary" onclick="ggoReserveOpen('','','')">@Icon("pin") Reserve a Client IP</button>
			}
		}
		<div class="card">
			if v.Error != "" {
				<div class="alert alert-err" role="alert">@Icon("circle-alert") <span>{ v.Error }</span></div>
			} else {
				<div class="toolbar leases-toolbar">
					<input
						class="form-control"
						type="search"
						placeholder="Search IP, MAC, hostname, or class…"
						aria-label="Search leases"
						data-bind="search"
						data-on:input__debounce.300ms="@get('/leases/search')"
					/>
					if v.CanReserve {
						@ImportReservationsForm(v.Page.CSRFToken)
					}
				</div>
				<div class="table-scroll">
					<table>
						<thead>
							<tr><th>IP</th><th>MAC</th><th>Hostname</th><th>Class</th><th>Expires in</th><th>Last seen</th><th aria-label="Actions"></th></tr>
						</thead>
						@LeasesBody(v.Leases, v.CanReserve)
					</table>
				</div>
			}
		</div>
		if v.Error == "" {
			@releaseDialog()
			if v.CanReserve {
				@resvDeleteDialog(v.Page.CSRFToken)
			}
			@leasesConfirmScript()
		}
		if v.CanReserve {
			@ReserveDialog(v.Page.CSRFToken, "/leases")
			@ReserveScript()
		}
	}
}

// ImportReservationsForm is the "Import CSV" control on the Leases page: a styled
// button that opens the file picker and auto-submits the upload (mac,ip,hostname) to
// /reservations/import. Native multipart POST (not Datastar) - it returns a flash +
// redirect like the single Reserve flow. Import is additive, so no confirm dialog.
templ ImportReservationsForm(csrf string) {
	<form method="post" action="/reservations/import" enctype="multipart/form-data" class="inline-form">
		<input type="hidden" name="csrf_token" value={ csrf }/>
		<input type="file" id="resv-import-file" name="file" accept=".csv,text/csv" hidden onchange="this.form.submit()"/>
		<button type="button" class="btn btn-secondary" onclick="document.getElementById('resv-import-file').click()">@Icon("upload") Import CSV</button>
	</form>
}

// LeasesBody is the live region (#leases-body), reused as the SSE/search fragment.
// Every row shows its real remaining lease time (the device renews and keeps the same
// fixed IP - the lease still counts down); a row with NO active lease shows a "—"
// expiry (an offline reservation) or a state badge (an online host awaiting its DHCP
// renewal after a lease purge, or a concluded static-in-pool device - see
// LeaseRow.NoLeaseState). A reserved row carries a filled-pin indicator next
// to its IP and a Remove-reservation action; a dynamic row offers Reserve + Release. A
// row behind a pinned switch port (PortPinned) shows the switch-port marker, offers no
// Reserve and a disabled delete - its IP is governed by the port pin, managed on the
// Port Pinning page, not here.
templ LeasesBody(rows []LeaseRow, canReserve bool) {
	<tbody id="leases-body">
		if len(rows) == 0 {
			<tr>
				<td colspan="7">
					<div class="empty">
						@Icon("network")
						<div class="empty-title">No leases or reservations</div>
						<div>Leased devices appear here as they request addresses; reserve a fixed IP with "Reserve a Client IP".</div>
					</div>
				</td>
			</tr>
		} else {
			for _, l := range rows {
				<tr>
					<td class="mono">
						if l.Presence != "" {
							<span class={ "status-dot", "lease-dot", leaseDot(l) } title={ leaseDotTitle(l) } role="img" aria-label={ leaseDotTitle(l) }></span>
						}
						{ l.IPAddress }
						if l.PortPinned {
							<span class="lease-pinned" title="Pinned to a switch port - manage on Port Pinning" role="img" aria-label="Pinned by switch port">@Icon("ethernet-port")</span>
						} else if l.Reserved {
							<span class="lease-reserved" title="Reserved - fixed IP for this MAC" role="img" aria-label="Reserved">@Icon("pin")</span>
						}
					</td>
					<td class="mono">{ l.HWAddress }</td>
					<td>{ orDash(l.Hostname) }</td>
					<td><span class="badge" title={ l.Class }>{ ClassDisplay(l.Class).Label }</span></td>
					if l.NoLeaseState != "" {
						// No data-expires: the countdown script rewrites every
						// [data-expires] cell's text and would stomp the badge.
						<td class="mono">
							<span class={ "badge", noLeaseBadgeClass(l.NoLeaseState) } title={ noLeaseTitle(l.NoLeaseState) }>{ noLeaseBadgeText(l.NoLeaseState) }</span>
						</td>
					} else {
						<td class="mono" data-expires={ itoa64(l.ExpiresAt) }>
							if l.ExpiresIn != "" {
								{ l.ExpiresIn }
							} else {
								<span class="text-muted">—</span>
							}
						</td>
					}
					<td class="mono">
						if l.LastSeenText != "" {
							<span title={ "Last active " + l.LastSeenText }>{ l.LastSeenText }</span>
							if l.Stale {
								<span class="badge badge-stale" title="No activity for over two weeks">stale</span>
							}
						} else {
							<span class="text-muted">—</span>
						}
					</td>
					<td>
						<div class="row-actions">
							if l.PortPinned {
								@portPinnedAction()
							} else if l.Reserved {
								if canReserve {
									@removeReservationButton(l)
								}
							} else {
								if canReserve {
									<button
										type="button"
										class="btn btn-sm btn-secondary"
										data-mac={ l.HWAddress }
										data-ip={ l.IPAddress }
										data-host={ l.RawHostname }
										onclick="ggoReserveOpen(this.dataset.mac, this.dataset.ip, this.dataset.host)"
										title={ "Reserve " + l.IPAddress + " for this device" }
										aria-label={ "Reserve " + l.IPAddress }
									>@Icon("pin")</button>
								}
								if l.NoLeaseState == "" {
									@releaseButton(l.IPAddress)
								}
							}
						</div>
					</td>
				</tr>
			}
		}
	</tbody>
}

// removeReservationButton opens the shared remove-reservation dialog
// (resvDeleteDialog, mounted outside the live region so a ticker morph can't
// wipe it) prefilled from the row's data attributes.
templ removeReservationButton(l LeaseRow) {
	<button
		type="button"
		class="btn btn-sm btn-danger"
		data-mac={ l.HWAddress }
		data-ip={ l.IPAddress }
		data-subnet={ itoa(l.SubnetID) }
		onclick="ggoResvDelOpen(this)"
		title="Remove reservation"
		aria-label="Remove reservation"
	>@Icon("pin-off")</button>
}

// portPinnedAction is the disabled remove control shown for a lease whose IP is fixed by
// a switch-port pin (flex-id). The pin - not this lease - governs the IP, and Kea resolves
// it before any hw-address reservation, so the row offers no Reserve and a disabled
// Remove: deleting the lease would just re-DHCP to the same pinned IP, and the pin itself
// is managed on the Port Pinning page. A leftover hw-address reservation for the same
// device (if any) stays deletable on its own row (see unifiedLeaseRowsWithPins), never
// from this pinned row. The ethernet-port marker next to the IP signals the pin.
templ portPinnedAction() {
	<button
		type="button"
		class="btn btn-sm btn-danger"
		disabled
		title="Pinned to a switch port - manage on Port Pinning"
		aria-label="Pinned to a switch port - manage on Port Pinning"
	>@Icon("pin-off")</button>
}

// releaseButton opens the shared release dialog prefilled with the row's IP.
templ releaseButton(ip string) {
	<button
		type="button"
		class="btn btn-sm btn-danger"
		title={ "Release lease for " + ip }
		aria-label={ "Release lease for " + ip }
		data-ip={ ip }
		onclick="ggoReleaseOpen(this)"
	>@Icon("trash-2")</button>
}

// releaseDialog is the single lease-release confirm dialog, mounted outside
// #leases-body so a live re-broadcast can't wipe it; ggoReleaseOpen stashes the
// row's IP on it. Not a POST form: the confirm button fires the Datastar
// @delete (releaseConfirmExpr), which reads the CSRF token from the page <meta>
// at click time.
templ releaseDialog() {
	<dialog id="release-dialog" aria-labelledby="release-dialog-title">
		<div class="dialog-head" id="release-dialog-title">Release this lease?</div>
		<div class="dialog-body">
			<p>The device loses its current address and requests a fresh one on its next DHCP cycle.</p>
			<dl class="kv">
				<dt>IP</dt><dd class="mono" id="release-dialog-ip"></dd>
			</dl>
		</div>
		<div class="dialog-foot">
			<button type="button" class="btn btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
			<button type="button" class="btn btn-danger-solid" data-on:click={ releaseConfirmExpr() }>@Icon("trash-2") Release Lease</button>
		</div>
	</dialog>
}

// resvDeleteDialog is the single remove-reservation confirm dialog, mounted
// outside #leases-body (see releaseDialog). The CSRF token is set from the page
// <meta> in onsubmit, matching the pre-dialog per-row form behavior.
templ resvDeleteDialog(csrf string) {
	<dialog id="resv-del-dialog" aria-labelledby="resv-del-dialog-title">
		<form method="post" action="/reservations/delete" data-busy onsubmit="this.querySelector('[name=csrf_token]').value=document.querySelector('meta[name=csrf-token]').content">
			<input type="hidden" name="csrf_token" value={ csrf }/>
			<input type="hidden" name="return" value="/leases"/>
			<input type="hidden" name="mac"/>
			<input type="hidden" name="subnet_id"/>
			<div class="dialog-head" id="resv-del-dialog-title">Remove this reservation?</div>
			<div class="dialog-body">
				<p>The device will fall back to a dynamic address.</p>
				<dl class="kv">
					<dt>MAC</dt><dd class="mono" id="resv-del-dialog-mac"></dd>
					<dt>IP</dt><dd class="mono" id="resv-del-dialog-ip"></dd>
				</dl>
			</div>
			<div class="dialog-foot">
				<button type="button" class="btn btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
				<button type="submit" class="btn btn-danger-solid">@Icon("pin-off") Remove Reservation</button>
			</div>
		</form>
	</dialog>
}

// leasesConfirmScript defines the openers for the two per-row confirm dialogs.
// One dialog instance per action lives at page level; each row button carries
// its target in data attributes (the ReserveDialog pattern).
templ leasesConfirmScript() {
	<script>
		window.ggoReleaseOpen = function (btn) {
			var d = document.getElementById("release-dialog");
			if (!d) return;
			d.dataset.ip = btn.dataset.ip || "";
			document.getElementById("release-dialog-ip").textContent = btn.dataset.ip || "";
			d.showModal();
		};
		window.ggoResvDelOpen = function (btn) {
			var d = document.getElementById("resv-del-dialog");
			if (!d) return;
			d.querySelector("[name=mac]").value = btn.dataset.mac || "";
			d.querySelector("[name=subnet_id]").value = btn.dataset.subnet || "";
			document.getElementById("resv-del-dialog-mac").textContent = btn.dataset.mac || "";
			document.getElementById("resv-del-dialog-ip").textContent = btn.dataset.ip || "";
			d.showModal();
		};
	</script>
}

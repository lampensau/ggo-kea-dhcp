package views

// UpdateBadge is the footer's #update-badge live region, next to the version
// line on every authenticated page. Empty (and invisible) when the box is
// current; otherwise a persistent indicator - a button that opens the update
// dialog (mounted globally by UpdateDialogs) and stays until no update is
// available. The same partial renders first paint and the SSE fragment.
//
// #update-badge and #update-dialogs are both shell live-regions pushed together
// (publishUpdateBadge), so whenever the badge is shown its dialog is mounted -
// including when the badge appears live over SSE on an already-open page. The
// click can therefore always open the dialog directly.
templ UpdateBadge(v UpdateView) {
	<span id="update-badge">
		if v.Available {
			<button type="button" class="update-badge" onclick="document.getElementById('update-dialog').showModal()" title={ "Update v" + v.Version + " available" }>@Icon("download") Update <span class="mono">v{ v.Version }</span></button>
		}
	</span>
}

// UpdateDialogs is the #update-dialogs shell region mounted in the global footer
// (base.templ) and re-pushed live alongside the badge. It carries no per-session
// secret (the install form reads CSRF from the page <meta> at submit), so it is
// safe to broadcast to every connected client.
templ UpdateDialogs(v UpdateView) {
	<div id="update-dialogs">
		if v.Available {
			@UpdateDialog(v)
			if v.Notes != "" {
				@ReleaseNotesDialog(v)
			}
			if v.CanInstall {
				if v.NeedsSystem {
					@updateInstallDialog(v, true)
				} else {
					@updateInstallDialog(v, false)
				}
			}
		}
	</div>
}

// UpdateDialog is the surface opened from the footer badge: the versions, the
// release notes at a glance, and Install. The X and Close just close it - the
// badge is a persistent indicator, not something to dismiss, so it stays until
// the update is installed. Install hands off to the password-gated confirm.
templ UpdateDialog(v UpdateView) {
	<dialog id="update-dialog" class="update-dialog" aria-labelledby="update-dialog-title">
		<div class="dialog-head" id="update-dialog-title">
			<span>@Icon("download") Software Update</span>
			<button type="button" class="dialog-x" aria-label="Close" onclick="this.closest('dialog').close()">@Icon("x")</button>
		</div>
		<div class="dialog-body">
			<p class="update-versions">Installed <span class="mono">v{ v.Current }</span>, new <span class="mono">v{ v.Version }</span> available.</p>
			<p class="help">{ updateScopeHint(v.Scope) }</p>
			if v.NeedsSystem {
				<div class="alert alert-warn" role="alert">
					@Icon("triangle-alert")
					<div class="alert-body">
						<strong>This release needs a system-scope update</strong>
						<span class="alert-detail">Installing with frozen dependencies failed because the release requires newer system packages. The broader install also upgrades those packages - expect a brief DHCP interruption.</span>
					</div>
				</div>
			}
			if !v.CanInstall {
				<p class="help">This release publishes no verification digest, so it cannot be installed from here. Update by re-running the installer.</p>
			}
			if v.Notes != "" {
				// Open notes on top of this dialog (native <dialog> stacking) instead of
				// closing it, so closing the notes returns here rather than dismissing
				// the whole update flow.
				<button type="button" class="update-notes-link" onclick="document.getElementById('update-notes-dlg').showModal()">@Icon("info") View release notes</button>
			}
		</div>
		<div class="dialog-foot">
			<button type="button" class="btn btn-secondary" onclick="this.closest('dialog').close()">Close</button>
			if v.CanInstall {
				if v.NeedsSystem {
					<button type="button" class="btn btn-danger" onclick="document.getElementById('update-install-sys-dlg').showModal()">@Icon("download") Install v{ v.Version }</button>
				} else {
					<button type="button" class="btn btn-primary" onclick="document.getElementById('update-install-dlg').showModal()">@Icon("download") Install v{ v.Version }</button>
				}
			}
		</div>
	</dialog>
}

// updateInstallDialog is the password-gated confirm for the privileged install
// (the reset.templ confirmDialog pattern, with the version - and for the
// escalation path the system scope - as hidden fields). system=true is the
// second-click broader path offered only after needs_system latched.
templ updateInstallDialog(v UpdateView, system bool) {
	<dialog id={ installDlgID(system) } aria-labelledby={ installDlgID(system) + "-title" }>
		<form method="post" action="/update/install" data-busy onsubmit="this.querySelector('[name=csrf_token]').value=document.querySelector('meta[name=csrf-token]').content">
			<input type="hidden" name="csrf_token" value=""/>
			<input type="hidden" name="version" value={ v.Version }/>
			if system {
				<input type="hidden" name="scope" value="system"/>
			}
			<div class="dialog-head" id={ installDlgID(system) + "-title" }>Install update v{ v.Version }?</div>
			<div class="dialog-body">
				if system {
					<p>Installing <span class="mono">v{ v.Version }</span> also updates system components the appliance depends on. DHCP pauses briefly and this page reconnects on its own.</p>
				} else {
					<p>Installing <span class="mono">v{ v.Version }</span> updates the appliance software. DHCP keeps serving and this page reconnects on its own.</p>
				}
				<div class="form-group">
					<label class="form-label" for={ installDlgID(system) + "-pw" }>Confirm your password</label>
					<input class="form-control" id={ installDlgID(system) + "-pw" } name="current_password" type="password" autocomplete="current-password" required/>
				</div>
			</div>
			<div class="dialog-foot">
				<button type="button" class="btn btn-secondary" onclick="this.closest('dialog').close()">Cancel</button>
				if system || v.Scope == "system" {
					<button type="submit" class="btn btn-danger-solid">Install Update</button>
				} else {
					<button type="submit" class="btn btn-primary">Install Update</button>
				}
			</div>
		</form>
	</dialog>
}

// ReleaseNotesDialog renders the fetched release body inline in a native
// <dialog>, so the notes are readable on an operator laptop with no internet.
// The body is remote content (a trust boundary): it is broken into plain
// blocks by parseReleaseNotes and every string is emitted through templ's
// escaping - never as markup.
templ ReleaseNotesDialog(v UpdateView) {
	<dialog id="update-notes-dlg" class="update-notes" aria-labelledby="update-notes-title">
		<div class="dialog-head" id="update-notes-title">Release Notes - v{ v.Version }</div>
		<div class="dialog-body">
			for _, b := range parseReleaseNotes(v.Notes) {
				switch b.Kind {
					case "h":
						<strong class="note-h">{ b.Text }</strong>
					case "list":
						<ul class="note-list">
							for _, it := range b.Items {
								<li>{ it }</li>
							}
						</ul>
					default:
						<p>{ b.Text }</p>
				}
			}
		</div>
		<div class="dialog-foot">
			<button type="button" class="btn btn-secondary" onclick="this.closest('dialog').close()">Close</button>
		</div>
	</dialog>
}

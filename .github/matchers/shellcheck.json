{
  "problemMatcher": [
    {
      "owner": "shellcheck-gcc",
      "severity": "warning",
      "pattern": [
        {
          "regexp": "^([^\\s:][^:]*):(\\d+):(\\d+):\\s+(warning|error|info):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      ]
    }
  ]
}

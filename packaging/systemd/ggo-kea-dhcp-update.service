[Unit]
Description=Green-GO Kea DHCP appliance self-update
Documentation=https://github.com/lampensau/ggo-kea-dhcp
# On-demand only: the control plane triggers this via its sudoers-scoped
# `systemctl start --no-block` after staging and verifying the new .deb. No
# [Install] section - never enabled, never started at boot.

[Service]
Type=oneshot
# Optional override of the update origin/repo (GGO_UPDATE_API / GGO_UPDATE_REPO);
# absent on a normal box, so the canonical GitHub feed is used. Must match the
# main unit's copy so the app and the digest gate agree.
EnvironmentFile=-/etc/ggo-kea-dhcp/update.env
ExecStart=/usr/lib/ggo-kea-dhcp/updater.sh
# A system-scope release runs a full apt update + dependency upgrade.
TimeoutStartSec=20min
# Runs as root with none of the main unit's sandboxing: it drives apt/dpkg,
# which need the whole filesystem.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ggo-kea-dhcp-update

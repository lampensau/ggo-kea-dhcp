# Passwordless sudo for the ggo-kea-dhcp service user, scoped to exactly the privileged
# tools the control plane shells out to (network reconfiguration + Kea config
# validation). Installed to /etc/sudoers.d/ggo-kea-dhcp (mode 0440) by the ggo-kea-dhcp
# package and validated with `visudo -c` in the postinstall script.
#
# The app invokes these by bare name (`sudo nmcli ...`); sudo resolves them via
# secure_path to the absolute paths below. Paths are the Debian Trixie (arm64)
# locations.
#
# Two tiers, to keep the blast radius of a web-UI compromise as small as practical:
#
# 1. Unrestricted arguments - nmcli/nft/hostapd/iw/iwlist/kea-dhcp4. Their argument
#    shapes vary per profile (interface names, CIDRs, SSIDs, rulesets), so scoping
#    them is impractical.
# 2. Exact-argument rules - systemctl, pkill, sysctl and ip are broad escalation
#    paths (any unit, any process, any kernel tunable; `ip netns exec ... sh` is a
#    trivial root shell), and the app only ever issues the fixed invocations below
#    (network/manager.go, hostapd.go, firewall.go). sudoers matches the FULL
#    argument list when arguments are given, so anything else (e.g. `systemctl stop
#    caddy`, `ip netns ...`) is refused. Any NEW systemctl/pkill/sysctl/ip
#    invocation added to the app needs a matching line here.
ggo-kea-dhcp ALL=(root) NOPASSWD: /usr/bin/nmcli, /usr/sbin/nft, \
	/usr/sbin/hostapd, /usr/sbin/iw, /usr/sbin/iwlist, /usr/sbin/kea-dhcp4, \
	/usr/sbin/ip -4 addr flush dev wlan0, \
	/usr/sbin/ip addr replace 172.31.255.1/24 dev wlan0, \
	/usr/sbin/ip link set wlan0 up, \
	/usr/sbin/ip addr del 172.31.255.1/24 dev wlan0, \
	/usr/bin/systemctl restart isc-kea-dhcp4-server, \
	/usr/bin/systemctl stop hostapd, \
	/usr/bin/systemctl reboot, \
	/usr/bin/systemctl poweroff, \
	/usr/bin/systemctl start --no-block ggo-kea-dhcp-update.service, \
	/usr/bin/journalctl -u ggo-kea-dhcp -n 200 --no-pager, \
	/usr/bin/pkill hostapd, \
	/usr/sbin/sysctl -w net.ipv4.ip_forward=0, \
	/usr/sbin/sysctl -w net.ipv4.ip_forward=1
